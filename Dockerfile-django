FROM python:3.12

WORKDIR /django-app
COPY ./backend/requirements.txt /django-app

RUN pip install --no-cache-dir -r requirements.txt

COPY ./backend/backend /django-app/backend
COPY ./backend/db.sqlite3 /django-app/
COPY ./backend/manage.py /django-app/
COPY ./backend/pet /django-app/pet

# Upgrade existing databases before serving requests after a model change.
CMD ["sh", "-c", "python manage.py migrate --noinput && exec python manage.py runserver 0.0.0.0:8000"]
